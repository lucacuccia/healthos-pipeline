# =============================================================================
# Health OS Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Run `python main.py --setup` for an interactive setup wizard.

# -----------------------------------------------------------------------------
# Data Source Preferences
# -----------------------------------------------------------------------------
# Which provider to use for each data type.
# Sleep:    oura | apple_health | manual
# Workouts: firestore | sheets | apple_health | manual
# Weight:   firestore | sheets | apple_health | manual
SLEEP_SOURCE=oura
WORKOUT_SOURCE=firestore
WEIGHT_SOURCE=firestore

# -----------------------------------------------------------------------------
# Oura Ring
# -----------------------------------------------------------------------------
# Personal access token from https://cloud.ouraring.com/personal-access-tokens
OURA_TOKEN=

# -----------------------------------------------------------------------------
# Google Cloud (Sheets + Firestore)
# -----------------------------------------------------------------------------
# Path to service account JSON (relative to project root)
# Create at: https://console.cloud.google.com/iam-admin/serviceaccounts
# Enable: Sheets API, Firestore API
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json

# Firestore project ID (only needed if WORKOUT_SOURCE or WEIGHT_SOURCE = firestore)
FIRESTORE_PROJECT_ID=your-firebase-project

# Google Sheets names (only needed if using sheets as a source)
EXERCISE_SHEET_NAME=Health OS - Exercise Log
REPORTS_LOG_SHEET_NAME=Health OS - Reports Log

# -----------------------------------------------------------------------------
# Apple Health (optional)
# -----------------------------------------------------------------------------
# Path to exported Apple Health export.xml
# Export from: iPhone > Health app > Profile > Export All Health Data
APPLE_HEALTH_EXPORT=

# -----------------------------------------------------------------------------
# Manual Data (optional)
# -----------------------------------------------------------------------------
# Directory for manual JSON/CSV data files
MANUAL_DATA_DIR=data/manual

# -----------------------------------------------------------------------------
# Telegram Notifications
# -----------------------------------------------------------------------------
# Create a bot via @BotFather on Telegram
# Get your chat ID by messaging @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# Email Notifications (Gmail)
# -----------------------------------------------------------------------------
# Use a Gmail App Password, not your regular password
# Create at: https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# -----------------------------------------------------------------------------
# Health Folder Monitoring (optional)
# -----------------------------------------------------------------------------
# Path to your Google Drive Health folder (mounted locally — used by --new-files
# and the local fallback watcher when Drive IDs below are not set).
HEALTH_FOLDER=

# Drive folder IDs — used by Cloud Run (no filesystem mount) to detect new/modified
# files via the Drive API. Pull from drive.google.com/drive/folders/<id>.
# Health Notes: surfaces new + modified files with .gdoc previews.
# Test Results: surfaces new files only (filenames, no preview).
HEALTH_NOTES_DRIVE_ID=
TEST_RESULTS_DRIVE_ID=

# -----------------------------------------------------------------------------
# Cloudflare Worker — Telegram Replies (optional)
# -----------------------------------------------------------------------------
WEBHOOK_URL=
RESPONSES_SECRET=

# -----------------------------------------------------------------------------
# Anomaly Monitoring Thresholds (optional)
# -----------------------------------------------------------------------------
# Override defaults for --monitor alerts. Omit to use defaults.
# MONITOR_SLEEP_SCORE_LOW=65
# MONITOR_HRV_DROP=15
# MONITOR_RHR_SPIKE=5
# MONITOR_RECOVERY_LOW=4
# MONITOR_MISSED_WORKOUTS_DAYS=5
# MONITOR_WEIGHT_CHANGE_LBS=3.0
